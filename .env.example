# Required in production: signs session cookies. Generate with `openssl rand -base64 32`.
SESSION_SECRET=

# Claude writes site copy and outreach messages. Without it, SiteFlip uses its
# built-in offline copywriter so the full flow still works.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5).
# ANTHROPIC_MODEL=claude-opus-5

# Google Places API (New) for real business search. Without it, realistic mock data is used.
GOOGLE_PLACES_API_KEY=

# Public URL used in live links and outreach messages (defaults to the request host).
# NEXT_PUBLIC_APP_URL=https://app.siteflip.example

# Placeholder Pro price shown on pricing and checkout.
NEXT_PUBLIC_PRO_PRICE_USD=39

# Where the JSON data store lives (defaults to ./data).
# SITEFLIP_DATA_DIR=./data
